{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "experimentalDecorators": true,
    "strict": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "preserveWatchOutput": true,
    "inlineSources": false,
    "noEmit": true,
    "removeComments": true,
    "sourceMap": false,
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "#/*": ["./src/*"],
      "@vben/access": ["./src/vben-packages/@vben/access/index.ts"],
      "@vben/common-ui": ["./src/vben-packages/@vben/common-ui/index.ts"],
      "@vben/common-ui/es/*": ["./src/vben-packages/@vben/common-ui/components/*"],
      "@vben/constants": ["./src/vben-packages/@vben/constants/index.ts"],
      "@vben/hooks": ["./src/vben-packages/@vben/hooks/index.ts"],
      "@vben/icons": ["./src/vben-packages/@vben/icons/index.ts"],
      "@vben/layouts": ["./src/vben-packages/@vben/layouts/index.ts"],
      "@vben/locales": ["./src/vben-packages/@vben/locales/index.ts"],
      "@vben/plugins": ["./src/vben-packages/@vben/plugins/index.ts"],
      "@vben/plugins/*": ["./src/vben-packages/@vben/plugins/*/index.ts"],
      "@vben/preferences": ["./src/vben-packages/@vben/preferences/index.ts"],
      "@vben/request": ["./src/vben-packages/@vben/request/index.ts"],
      "@vben/stores": ["./src/vben-packages/@vben/stores/index.ts"],
      "@vben/styles": ["./src/vben-packages/@vben/styles/index.ts"],
      "@vben/styles/*": ["./src/vben-packages/@vben/styles/*"],
      "@vben/tailwind-config": ["./src/vben-packages/@vben/tailwind-config/index.ts"],
      "@vben/tailwind-config/*": ["./src/vben-packages/@vben/tailwind-config/*"],
      "@vben/types": ["./src/vben-packages/@vben/types/index.ts"],
      "@vben/types/*": ["./src/vben-packages/@vben/types/*"],
      "@vben/utils": ["./src/vben-packages/@vben/utils/index.ts"],
      "@vben-core/design": ["./src/vben-packages/@vben-core/design/index.ts"],
      "@vben-core/design/*": ["./src/vben-packages/@vben-core/design/*"],
      "@vben-core/design/bem": ["./src/vben-packages/@vben-core/design/less-bem/bem.less"],
      "@vben-core/design/theme": ["./src/vben-packages/@vben-core/design/css/global.css"],
      "@vben-core/icons": ["./src/vben-packages/@vben-core/icons/index.ts"],
      "@vben-core/shared": ["./src/vben-packages/@vben-core/shared/index.ts"],
      "@vben-core/shared/*": ["./src/vben-packages/@vben-core/shared/*"],
      "@vben-core/typings": ["./src/vben-packages/@vben-core/typings/index.ts"],
      "@vben-core/typings/*": ["./src/vben-packages/@vben-core/typings/*"],
      "@vben-core/composables": ["./src/vben-packages/@vben-core/composables/index.ts"],
      "@vben-core/preferences": ["./src/vben-packages/@vben-core/preferences/index.ts"],
      "@vben-core/form-ui": ["./src/vben-packages/@vben-core/form-ui/index.ts"],
      "@vben-core/layout-ui": ["./src/vben-packages/@vben-core/layout-ui/index.ts"],
      "@vben-core/menu-ui": ["./src/vben-packages/@vben-core/menu-ui/index.ts"],
      "@vben-core/popup-ui": ["./src/vben-packages/@vben-core/popup-ui/index.ts"],
      "@vben-core/shadcn-ui": ["./src/vben-packages/@vben-core/shadcn-ui/index.ts"],
      "@vben-core/tabs-ui": ["./src/vben-packages/@vben-core/tabs-ui/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
